# --- Sanity (CMS) ---
# Create a free project at https://www.sanity.io/manage, then copy its ID here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01
# Only needed to run `npm run seed`. Create at
# https://www.sanity.io/manage -> your project -> API -> Tokens ("Editor" permissions).
# Never expose this in client code — it's server-only.
SANITY_API_TOKEN=

# --- Booking form email (Resend) ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that should receive booking inquiries.
BOOKING_NOTIFICATION_EMAIL=
# Optional. Must be a verified domain in Resend once you have one;
# until then the Resend sandbox sender (onboarding@resend.dev) is used.
BOOKING_FROM_EMAIL=
